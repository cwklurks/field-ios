<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The keys the build settings can't write; Xcode merges the rest in. -->
	<!-- Web links from other apps (Arrivals). What Apple asks of a browser before it can be the default; until the entitlement is granted, iOS still sends them to Safari. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.connork.fieldbrowser.web</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
		</dict>
#ifdef FIELD_TEST_SCHEME
		<!-- Debug only: the field-test scheme (field-test:open?url=a link), the UI tests' way to hand a running Field a link, since iOS sends http to the default browser (Arrivals). -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.connork.fieldbrowser.test</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>field-test</string>
			</array>
		</dict>
#endif
	</array>
	<!-- Pages may be plain http (a router, a dev server); the app's own requests stay https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
